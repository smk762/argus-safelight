# Copy to .env. Compose reads this file from the repo root.

# Darkroom URL the browser calls. Baked into the web image at build; a change
# needs `docker compose up --build`. With a localhost value the host follows
# the page, so a page opened as this machine's LAN address calls that same
# address on port 8106.
NEXT_PUBLIC_DARKROOM_URL=http://localhost:8106

# Host port published for the mock darkroom. Keep it in step with the URL above.
MOCK_PORT=8106

# Shows the Purge all button. Darkroom's compose maps the same name to
# ARGUS_DARKROOM_DEVMODE, and darkroom refuses the purge when it is off.
DEVMODE=1

# Mock switches, to see how the page behaves when a backend is missing.
# 0 turns one off. The real darkroom reports these from /health.
MOCK_NSFW_ALLOWED=1
MOCK_OLLAMA=1
MOCK_SINGGUARD=1
MOCK_NUDENET=1
MOCK_AGE=1
